// Configuration de test local (sans IA, qui demande un compte Cloudflare)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-santa-anouche",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-santa"
    }
  ],
  "observability": { "enabled": false }
}
